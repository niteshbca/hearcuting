# ===== SalonPro server configuration =====
# Copy to server/.env and fill in real values. NEVER commit real secrets.

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://niteshkumarsingh1500_db_user:E7Y2uaLPP6ivOKj3@cluster0.885dplu.mongodb.net/

# Generate strong secrets: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-min-32
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated allowed frontend origins (CORS + email links)
CLIENT_ORIGINS=http://localhost:5173

# Salon default timezone (IANA) — used for business hours, slots, reports
TIMEZONE=Asia/Kolkata

RATE_LIMIT_ENABLED=true
LOG_LEVEL=debug
MAX_UPLOAD_MB=5

# ===== Email (Nodemailer SMTP) =====
# If SMTP_HOST is empty, emails are logged to the dev transport (json) and
# recorded in EmailDeliveryLog with transport="json". Use a real SMTP account
# (Gmail App Password, Mailtrap, SendGrid, Amazon SES, Brevo...) in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourdomain.com
SMTP_FROM_NAME=SalonPro
EMAIL_REMINDER_HOURS_BEFORE=3

# ===== Online payments (optional, Razorpay) =====
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ===== Image storage (optional, Cloudinary unsigned upload) =====
# Leave empty to store uploads on the server disk (served from /uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ===== One-time owner setup (used by `npm run create-owner`) =====
# Leave blank to get a generated password printed once by the CLI.
OWNER_NAME=Salon Owner
OWNER_EMAIL=owner@salonpro.local
OWNER_PASSWORD=
